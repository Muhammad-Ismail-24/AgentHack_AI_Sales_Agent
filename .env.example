# ── LLM (Google Gemini) ─────────────────────────────────────────────
# Either name works; GEMINI_API_KEY wins when both are set.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Requests/minute the shared key may spend (free tier = 15; default 14).
GEMINI_RPM=14

# ── Web search / research ───────────────────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Contact enrichment ──────────────────────────────────────────────
APOLLO_API_KEY=
HUNTER_API_KEY=

# ── Vector store ────────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── Database (Firestore) ────────────────────────────────────────────
# Absolute path to your Firebase service-account JSON. Required.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
# Set instead of the above to run against a local emulator, e.g. localhost:8080
FIRESTORE_EMULATOR_HOST=

# ── Cache / short-term memory ───────────────────────────────────────
REDIS_URL=

# ── Email: SMTP is the active path ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
# Optional alternative sender, used only when SMTP is not configured.
RESEND_API_KEY=

# ── Meetings ────────────────────────────────────────────────────────
CAL_API_KEY=

# ── WhatsApp (Twilio) — currently switched off ──────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ADMIN_WHATSAPP_NUMBER=

# ── Frontend ────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
